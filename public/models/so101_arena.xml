<mujoco model="SO-101 Arena">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.004" integrator="implicitfast" gravity="0 0 -9.81"/>

  <!--
    Compact collision model derived from TheRobotStudio's open SO-101 MJCF.
    Joint names, ranges, motor forces, and the six-axis hierarchy match the
    source model; primitive geoms keep the browser simulation lightweight.
  -->
  <default>
    <joint damping="0.60" frictionloss="0.052" armature="0.028" limited="true"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.05 0.01" density="700" rgba="0.21 0.31 0.26 1"/>
    <position kp="70" kv="3" forcerange="-3.35 3.35"/>
  </default>

  <worldbody>
    <light pos="0 -1.5 2.2" dir="0 0.6 -1" diffuse="0.9 0.9 0.85"/>
    <geom name="floor" type="plane" size="1.2 1.2 0.05" rgba="0.87 0.85 0.79 1"/>

    <body name="base" pos="-0.16 0 0.045">
      <geom name="base_collision" type="box" size="0.09 0.075 0.045"/>
      <body name="shoulder" pos="0 0 0.08">
        <joint axis="0 0 1" name="shoulder_pan" type="hinge" range="-1.919862 1.919862"/>
        <geom type="cylinder" size="0.055 0.045" rgba="0.94 0.58 0.23 1"/>
        <body name="upper_arm" pos="0 0 0.035">
          <joint axis="0 1 0" name="shoulder_lift" type="hinge" range="-1.745329 1.745329"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.22" size="0.036"/>
          <body name="lower_arm" pos="0 0 0.22">
            <joint axis="0 1 0" name="elbow_flex" type="hinge" range="-1.69 1.69"/>
            <geom type="cylinder" size="0.05 0.035" euler="1.5708 0 0" rgba="0.94 0.58 0.23 1"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.205" size="0.032"/>
            <body name="wrist" pos="0 0 0.205">
              <joint axis="0 1 0" name="wrist_flex" type="hinge" range="-1.658063 1.658063"/>
              <geom type="cylinder" size="0.045 0.032" euler="1.5708 0 0" rgba="0.94 0.58 0.23 1"/>
              <geom type="capsule" fromto="0 0 0 0 0 0.095" size="0.026"/>
              <body name="wrist_roll_link" pos="0 0 0.095">
                <joint axis="0 0 1" name="wrist_roll" type="hinge" range="-2.743847 2.841206"/>
                <geom type="cylinder" size="0.035 0.042" rgba="0.12 0.16 0.14 1"/>
                <body name="gripper" pos="0 0 0.06">
                  <joint axis="0 1 0" name="gripper" type="hinge" range="-0.174533 1.745329"/>
                  <geom type="box" size="0.035 0.042 0.025" rgba="0.94 0.58 0.23 1"/>
                  <geom type="box" pos="0.036 0 0.045" size="0.009 0.015 0.052" rgba="0.12 0.16 0.14 1"/>
                  <geom type="box" pos="-0.036 0 0.045" size="0.009 0.015 0.052" rgba="0.12 0.16 0.14 1"/>
                  <site name="grip_site" pos="0 0 0.08" size="0.008" rgba="1 0.25 0.1 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="cube" pos="0.22 -0.04 0.04">
      <freejoint/>
      <geom name="cube_geom" type="box" size="0.04 0.04 0.04" mass="0.08" rgba="0.94 0.31 0.18 1"/>
    </body>
    <site name="target" pos="0.22 -0.04 0.15" size="0.055" type="sphere" rgba="0.94 0.31 0.18 0.08"/>
  </worldbody>

  <actuator>
    <position name="shoulder_pan" joint="shoulder_pan" ctrlrange="-1.919862 1.919862"/>
    <position name="shoulder_lift" joint="shoulder_lift" ctrlrange="-1.745329 1.745329"/>
    <position name="elbow_flex" joint="elbow_flex" ctrlrange="-1.69 1.69"/>
    <position name="wrist_flex" joint="wrist_flex" ctrlrange="-1.658063 1.658063"/>
    <position name="wrist_roll" joint="wrist_roll" ctrlrange="-2.743847 2.841206"/>
    <position name="gripper" joint="gripper" ctrlrange="-0.174533 1.745329"/>
  </actuator>

  <sensor>
    <jointpos name="shoulder_pan_pos" joint="shoulder_pan"/>
    <jointpos name="shoulder_lift_pos" joint="shoulder_lift"/>
    <jointpos name="elbow_flex_pos" joint="elbow_flex"/>
    <jointpos name="wrist_flex_pos" joint="wrist_flex"/>
    <jointpos name="wrist_roll_pos" joint="wrist_roll"/>
    <jointpos name="gripper_pos" joint="gripper"/>
  </sensor>
</mujoco>
